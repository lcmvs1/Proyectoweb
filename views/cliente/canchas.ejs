<%- include('../partials/navbar') %>

    <div class="container mt-4">

        <h2 class="text-success mb-4"> Canchas Disponibles</h2>

        <div class="row">

            <% canchas.forEach(c=> { %>

                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm p-3">

                        <h5>
                            <%= c.nombre %>
                        </h5>

                        <p> <%= c.precio_por_hora %> Bs / hora</p>

                        <a href="/canchas/<%= c.id %>/horarios" class="btn btn-success">
                            Ver horarios
                        </a>

                    </div>
                </div>

                <% }) %>

        </div>

    </div>